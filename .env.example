# ===========================================
# Eduzz → Loggi Automation - Configurações
# ===========================================

# Porta do servidor
APP_PORT=3000

# ===========================================
# Shipping Provider (Transportadora)
# ===========================================
# Provider de envio: 'loggi' ou 'melhorenvio'
# loggi: Integração direta com Loggi (requer LOGGI_CLIENT_ID, LOGGI_CLIENT_SECRET, LOGGI_COMPANY_ID)
# melhorenvio: Integração via Melhor Envio (requer MELHOR_ENVIO_TOKEN)
SHIPPING_PROVIDER=loggi

# ===========================================
# Eduzz Webhook
# ===========================================
# Chave secreta para validar assinatura HMAC-SHA256 do webhook Eduzz
EDUZZ_WEBHOOK_SECRET=your_eduzz_webhook_secret_here

# IDs de produtos físicos permitidos (csv, separados por vírgula)
EDUZZ_ALLOWED_PRODUCT_IDS=12345,67890

# SKUs permitidos (csv, separados por vírgula) - alternativa/complemento ao product IDs
EDUZZ_ALLOWED_SKUS=ADESIVO-01,ADESIVO-02

# ===========================================
# Loggi API
# ===========================================
# URL base da API Loggi (sem barra no final)
# Produção: https://api.loggi.com
# Staging: https://stg.api.loggi.com
LOGGI_BASE_URL=https://api.loggi.com

# Credenciais OAuth2 da Loggi
LOGGI_CLIENT_ID=your_loggi_client_id
LOGGI_CLIENT_SECRET=your_loggi_client_secret

# ID da empresa na Loggi
LOGGI_COMPANY_ID=your_company_id

# ===========================================
# Melhor Envio API (alternativa ao Loggi)
# ===========================================
# Token de autenticação do Melhor Envio
MELHOR_ENVIO_TOKEN=your_melhor_envio_token

# Client ID do Melhor Envio
MELHOR_ENVIO_CLIENT_ID=22043

# Usar ambiente sandbox (true/false)
MELHOR_ENVIO_SANDBOX=false

# ===========================================
# Endereço de Origem (Remetente)
# ===========================================
ORIGIN_NAME=Minha Empresa
ORIGIN_PHONE=11999999999
ORIGIN_EMAIL=contato@minhaempresa.com
ORIGIN_STREET=Rua das Flores
ORIGIN_NUMBER=123
ORIGIN_COMPLEMENT=Sala 1
ORIGIN_NEIGHBORHOOD=Centro
ORIGIN_CITY=São Paulo
ORIGIN_STATE=SP
ORIGIN_ZIP=01234567

# ===========================================
# Pacote Padrão (dimensões para adesivos)
# ===========================================
# Peso em gramas
PACKAGE_WEIGHT_G=50

# Dimensões em centímetros
PACKAGE_LENGTH_CM=12
PACKAGE_WIDTH_CM=7
PACKAGE_HEIGHT_CM=0.5

# ===========================================
# Jobs / Retry
# ===========================================
# Intervalo em ms para processar a fila de jobs
JOB_POLL_INTERVAL_MS=5000

# Máximo de tentativas para jobs com erro
JOB_MAX_RETRIES=5

# ===========================================
# Unnichat (WhatsApp Notifications)
# ===========================================
# URL base da API Unnichat
UNNICHAT_API_URL=https://unnichat.com.br/api

# Token de autenticação
UNNICHAT_TOKEN=your_unnichat_token_here

# Habilitar envio de notificações WhatsApp (true/false)
UNNICHAT_ENABLED=false
